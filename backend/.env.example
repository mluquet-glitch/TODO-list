# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto HTTP del servidor Express
PORT=3000

# Conexión a PostgreSQL. Si defines DATABASE_URL, tiene prioridad sobre las variables PG*.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tareas

# Alternativa por variables sueltas (solo se usan si DATABASE_URL está vacío)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=tareas

# --- SSL ---------------------------------------------------------------------
# SSL va activado por defecto (sin verificar el certificado, válido para
# Neon/Supabase/Vercel Postgres y cadenas self-signed).
# PGSSL=false lo desactiva (útil con un Postgres local sin SSL).
# PGSSL=false
#
# Opcional: CA en PEM para verificar de verdad el certificado. Si se define,
# se activa rejectUnauthorized. Los saltos de línea pueden ir como "\n".
# PGSSLCA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
#
# Nota: cualquier `sslmode` en DATABASE_URL se elimina al arrancar, porque `pg`
# lo aplicaba después de la configuración y provocaba "self-signed certificate
# in certificate chain".

# Origen permitido por CORS (el frontend de Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173

# --- Autenticación JWT -------------------------------------------------------
# Obligatorio en producción (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-in-production-32-chars
# Vida del access token (formatos de jsonwebtoken: 15m, 1h, 7d...)
JWT_ACCESS_EXPIRES_IN=15m
# Vida del refresh token en días
JWT_REFRESH_EXPIRES_DAYS=7

# --- Cookie del refresh token ------------------------------------------------
# lax | strict | none (none requiere HTTPS y COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# En producción se fuerza true salvo que se indique lo contrario aquí
# COOKIE_SECURE=true
